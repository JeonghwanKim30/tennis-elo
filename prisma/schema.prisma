// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  BANNED
}

enum MatchType {
  SINGLES
  DOUBLES
}

enum MatchResult {
  TEAM_A_WIN
  TEAM_B_WIN
  DRAW
}

enum MatchStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParticipationStatus {
  PENDING
  ATTENDING
  NOT_ATTENDING
}

model User {
  id               String     @id @default(cuid())
  name             String
  phone            String     @unique
  pinHash          String
  role             Role       @default(USER)
  status           UserStatus @default(PENDING)
  gender           Gender     @default(MALE)
  profileImage     Bytes?
  profileImageType String?
  bio              String?
  createdAt        DateTime   @default(now())
  approvedAt       DateTime?
  approvedBy       String?

  ratings                EloRating[]
  submittedMatches       Match[]               @relation("SubmittedMatches")
  eloHistory             EloHistory[]
  matchDayParticipations MatchDayParticipant[]
  createdMatchDays       MatchDay[]            @relation("CreatedMatchDays")
}

model MatchDay {
  id        String   @id @default(cuid())
  date      DateTime @unique
  time      String?
  location  String?
  createdBy String
  createdAt DateTime @default(now())

  creator      User                  @relation("CreatedMatchDays", fields: [createdBy], references: [id])
  participants MatchDayParticipant[]
  matches      Match[]
}

model MatchDayParticipant {
  matchDayId String
  userId     String
  status     ParticipationStatus @default(PENDING)

  matchDay MatchDay @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([matchDayId, userId])
}

model EloRating {
  userId String
  type   MatchType
  rating Float     @default(1200)
  wins   Int       @default(0)
  losses Int       @default(0)
  draws  Int       @default(0)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, type])
}

// 복식의 경우 각 팀의 player1은 포핸드, player2는 백핸드 포지션을 의미한다.
// result/score는 admin이 점수를 입력해 경기를 완료 처리하기 전까지는 비어있다 (status=PENDING).
model Match {
  id             String       @id @default(cuid())
  matchDayId     String
  type           MatchType
  teamAPlayer1   String
  teamAPlayer2   String?
  teamBPlayer1   String
  teamBPlayer2   String?
  result         MatchResult?
  teamAScore     Int?
  teamBScore     Int?
  teamAEloChange Int?
  teamBEloChange Int?
  status         MatchStatus  @default(PENDING)
  submittedBy    String
  submittedAt    DateTime     @default(now())
  approvedBy     String?
  approvedAt     DateTime?
  approvalSeq    Int?         @unique

  matchDay   MatchDay     @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  submitter  User         @relation("SubmittedMatches", fields: [submittedBy], references: [id])
  eloHistory EloHistory[]
}

model EloHistory {
  id           String    @id @default(cuid())
  matchId      String
  userId       String
  type         MatchType
  ratingBefore Float
  ratingAfter  Float
  delta        Float
  createdAt    DateTime  @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
}
