// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  BANNED
}

enum MatchType {
  SINGLES
  DOUBLES
}

enum MatchResult {
  TEAM_A_WIN
  TEAM_B_WIN
  DRAW
}

enum MatchStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParticipationStatus {
  PENDING
  ATTENDING
  NOT_ATTENDING
}

// 일반 경기일 vs MT/대회 같은 특수 이벤트. 특수 이벤트만 제목/코트/진행시간/
// 총 경기 수와 외부 게스트 명단을 함께 갖는다.
enum MatchDayKind {
  REGULAR
  SPECIAL
}

// 특수 이벤트 결과를 ELO에 반영하는 범위.
// - NONE: 스코어/승패만 기록하고 레이팅은 건드리지 않는다(MT 기본값) — 게스트
//   MMR은 관리자 추정치라 실제 래더에 섞으면 레이팅이 오염되고, 친선 경기라
//   점수대도 들쭉날쭉하다.
// - MEMBERS_ONLY: 게스트 MMR은 "상대 실력 추정치"로 계산에만 쓰고,
//   EloRating/EloHistory는 회원에게만 기록한다(대회용).
enum EventEloMode {
  NONE
  MEMBERS_ONLY
}

model User {
  id                  String     @id @default(cuid())
  name                String
  phone               String     @unique
  pinHash             String
  role                Role       @default(USER)
  status              UserStatus @default(PENDING)
  gender              Gender     @default(MALE)
  profileImage        Bytes?
  profileImageType    String?
  bio                 String?
  createdAt           DateTime   @default(now())
  approvedAt          DateTime?
  approvedBy          String?
  // 마지막으로 본인 프로필에서 "확인한" 티어(TierKey 문자열, 예: "GOLD"). 이후 경기
  // 결과로 티어가 바뀌면 다음 프로필 방문 시 승급/강등 안내를 보여주고 이 값을 갱신한다.
  lastSeenTierSingles String?
  lastSeenTierDoubles String?

  ratings                EloRating[]
  submittedMatches       Match[]               @relation("SubmittedMatches")
  eloHistory             EloHistory[]
  matchDayParticipations MatchDayParticipant[]
  createdMatchDays       MatchDay[]            @relation("CreatedMatchDays")
  uploadedMatchDayPhotos MatchDayPhoto[]

  // 리더보드/경기 목록/관리자 페이지 전부 status="ACTIVE"(또는 "PENDING")로
  // 필터링해서 조회한다 — status 단독 인덱스가 없으면 회원 수가 늘어날수록
  // 매 페이지 방문마다 User 테이블 전체를 순차 스캔하게 된다.
  @@index([status])
}

model MatchDay {
  id        String   @id @default(cuid())
  date      DateTime @unique
  time      String?
  location  String?
  createdBy String
  createdAt DateTime @default(now())

  // ── 특수 이벤트(MT/대회) 전용 필드 ──────────────────────────────
  // kind=REGULAR이면 전부 null/기본값이고, 아래 값들은 SPECIAL일 때만 의미가 있다.
  kind              MatchDayKind @default(REGULAR)
  // 이벤트 제목(예: "2026 가을 테니스 MT"). 일반 경기일은 날짜가 곧 제목이라 비워둔다.
  title             String?
  // 진행 시간 — "15:00" ~ "19:00". 일반 경기일의 time과 달리 시작/종료가 모두
  // 필요한 이유는, 이 구간을 총 경기 수/코트 수로 나눠 타임슬롯을 계산하기 때문이다
  // (lib/eventSchedule.ts 참고 — 슬롯 시각을 경기마다 중복 저장하지 않는다).
  startTime         String?
  endTime           String?
  // 이벤트에서 치를 총 경기 수(예: 12). 타임슬롯 개수 계산과 "배치 n / N" 진행 표시에 쓴다.
  plannedMatchCount Int?
  eloMode           EventEloMode @default(NONE)

  creator      User                  @relation("CreatedMatchDays", fields: [createdBy], references: [id])
  participants MatchDayParticipant[]
  matches      Match[]
  photos       MatchDayPhoto[]
  courts       EventCourt[]
  guests       EventGuest[]
}

// 날짜당 현장 사진 여러 장(최대 10장, MatchDayPhoto.ts의 MAX_PHOTOS_PER_DAY 참고).
model MatchDayPhoto {
  id         String   @id @default(cuid())
  matchDayId String
  image      Bytes
  imageType  String
  uploadedBy String
  createdAt  DateTime @default(now())

  matchDay MatchDay @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploadedBy], references: [id])
}

model MatchDayParticipant {
  matchDayId String
  userId     String
  status     ParticipationStatus @default(PENDING)

  matchDay MatchDay @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([matchDayId, userId])
}

// 특수 이벤트의 코트(예: A코트/B코트/C코트). 타임라인 대진표의 "열"에 해당한다.
model EventCourt {
  id         String @id @default(cuid())
  matchDayId String
  name       String
  // 타임라인에서 왼쪽부터 보여줄 순서.
  order      Int

  matchDay MatchDay @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  matches  Match[]

  @@unique([matchDayId, name])
  @@index([matchDayId])
}

// 특수 이벤트에만 참가하는 외부 게스트 — 계정(ID/PIN)이 없고 관리자가 이름/
// 성별/MMR만 직접 입력해 당일 명단에 임시로 올린다.
//
// User가 아닌 별도 테이블로 둔 이유:
// 1) Match.teamAPlayer1 등은 FK가 아닌 순수 String 컬럼이라, 여기서 만든 cuid를
//    그대로 넣어도 제약 위반이 없다(회원과 같은 자리에 섞여 들어갈 수 있다).
// 2) 반대로 EloRating/EloHistory/MatchDayParticipant.userId는 모두 User FK라,
//    게스트를 User로 만들면 phone @unique/pinHash NOT NULL을 풀어야 하고
//    리더보드/검색/참석 명단의 status 필터마다 게스트 제외를 빠뜨리면 그대로
//    랭킹에 노출되는 사고가 된다. 별도 테이블이면 그 유입 자체가 구조적으로 불가능하다.
// 3) 이벤트에 종속된 수명(이벤트 삭제 시 함께 정리)이 데이터 성격과 일치한다.
model EventGuest {
  id         String   @id @default(cuid())
  matchDayId String
  name       String
  gender     Gender
  // 관리자가 추정한 실력(ELO 환산값). eloMode=MEMBERS_ONLY인 이벤트에서
  // "상대 실력 추정치"로 계산에만 쓰이고, 게스트 본인의 레이팅은 저장되지 않는다.
  mmr        Float    @default(1200)
  createdBy  String
  createdAt  DateTime @default(now())

  matchDay MatchDay @relation(fields: [matchDayId], references: [id], onDelete: Cascade)

  // 같은 이벤트 안에 동명 게스트가 둘 생기면 대진표에서 구분이 불가능하다.
  @@unique([matchDayId, name])
  @@index([matchDayId])
}

model EloRating {
  userId String
  type   MatchType
  rating Float     @default(1200)
  wins   Int       @default(0)
  losses Int       @default(0)
  draws  Int       @default(0)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, type])
}

// 복식의 경우 각 팀의 player1은 포핸드, player2는 백핸드 포지션을 의미한다.
// result/score는 admin이 점수를 입력해 경기를 완료 처리하기 전까지는 비어있다 (status=PENDING).
model Match {
  id             String       @id @default(cuid())
  matchDayId     String
  type           MatchType
  teamAPlayer1   String
  teamAPlayer2   String?
  teamBPlayer1   String
  teamBPlayer2   String?
  result         MatchResult?
  teamAScore     Int?
  teamBScore     Int?
  teamAEloChange Int?
  teamBEloChange Int?
  status         MatchStatus  @default(PENDING)
  submittedBy    String
  submittedAt    DateTime     @default(now())
  approvedBy     String?
  approvedAt     DateTime?
  approvalSeq    Int?         @unique

  // ── 특수 이벤트 전용 배치 정보 ──────────────────────────────────
  // 일반 경기는 둘 다 null이다. 이벤트 경기는 "어느 코트, 몇 번째 시간대"에
  // 놓였는지를 이 두 값으로 표현한다 — 슬롯의 실제 시각은 저장하지 않고
  // MatchDay의 startTime~endTime에서 파생한다(lib/eventSchedule.ts).
  courtId   String?
  slotIndex Int?

  matchDay   MatchDay     @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  submitter  User         @relation("SubmittedMatches", fields: [submittedBy], references: [id])
  court      EventCourt?  @relation(fields: [courtId], references: [id], onDelete: SetNull)
  eloHistory EloHistory[]

  // 한 코트의 한 시간대에는 경기가 하나만 놓일 수 있다 — 같은 칸에 두 경기가
  // 겹치는 것을 DB 차원에서 막는다(같은 "사람"이 한 시간대에 두 번 나오는 것은
  // 4개 컬럼에 걸친 규칙이라 제약으로 표현할 수 없어 서버 액션에서 검증한다).
  @@unique([matchDayId, courtId, slotIndex])
  // matchDayId: 경기일 상세 페이지(/matches/[dayId])를 열 때마다 그 날짜의
  // 경기를 매치데이 FK로 조회한다 — Prisma는 FK 컬럼을 자동으로 인덱싱하지
  // 않으므로 명시적으로 추가한다.
  @@index([matchDayId])
  // (status, approvalSeq): 관리자 "경기 승패 입력" 탭이 PENDING 경기 목록과
  // "APPROVED 경기를 approvalSeq 내림차순 30건" 조회를 매번 실행한다 —
  // 이 복합 인덱스로 필터+정렬+LIMIT을 별도 정렬 없이 인덱스 스캔만으로 처리한다.
  @@index([status, approvalSeq])
}

model EloHistory {
  id           String    @id @default(cuid())
  matchId      String
  userId       String
  type         MatchType
  ratingBefore Float
  ratingAfter  Float
  delta        Float
  createdAt    DateTime  @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
}
