// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  BANNED
}

enum MatchType {
  SINGLES
  DOUBLES
}

enum MatchResult {
  TEAM_A_WIN
  TEAM_B_WIN
  DRAW
}

enum MatchStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParticipationStatus {
  PENDING
  ATTENDING
  NOT_ATTENDING
}

enum KakaoMessageType {
  MATCH_CREATED
  MVP_SELECTED
  VOTE_REMINDER
  BROADCAST
}

// 실제 발송 대행사(카카오 알림톡 비즈메시지 API 등) 연동 전까지는 모든 메시지가
// STUBBED로 기록된다 — lib/kakao.ts 참고.
enum KakaoMessageStatus {
  STUBBED
  SENT
  FAILED
}

model User {
  id                  String     @id @default(cuid())
  name                String
  phone               String     @unique
  pinHash             String
  role                Role       @default(USER)
  status              UserStatus @default(PENDING)
  gender              Gender     @default(MALE)
  profileImage        Bytes?
  profileImageType    String?
  bio                 String?
  createdAt           DateTime   @default(now())
  approvedAt          DateTime?
  approvedBy          String?
  // 마지막으로 본인 프로필에서 "확인한" 티어(TierKey 문자열, 예: "GOLD"). 이후 경기
  // 결과로 티어가 바뀌면 다음 프로필 방문 시 승급/강등 안내를 보여주고 이 값을 갱신한다.
  lastSeenTierSingles String?
  lastSeenTierDoubles String?

  // 카카오톡 계정 연동 — kakaoId는 카카오 회원번호(고유). 연동 해제 시 세 필드
  // 모두 null로 되돌리고(전화번호처럼 masking하지 않음, 재연동 시 새로 채움),
  // 수신 동의는 연동 해제와 별개로 언제든 토글 가능하다.
  kakaoId          String?   @unique
  kakaoNickname    String?
  kakaoConnectedAt DateTime?
  kakaoNotifyOptIn Boolean   @default(false)

  ratings                EloRating[]
  submittedMatches       Match[]               @relation("SubmittedMatches")
  eloHistory             EloHistory[]
  matchDayParticipations MatchDayParticipant[]
  createdMatchDays       MatchDay[]            @relation("CreatedMatchDays")
  uploadedMatchDayPhotos MatchDayPhoto[]
  noticeBroadcasts       NoticeBroadcast[]
  kakaoMessageLogs       KakaoMessageLog[]
}

// 관리자 "공지설정" 탭의 자동 알림 ON/OFF 스위치. 행이 하나만 존재하는
// 싱글턴 테이블(id 고정값) — lib/notice.ts의 getNoticeSettings()가 없으면
// 만들고, 있으면 그대로 돌려준다.
model NoticeSettings {
  id                  String   @id @default("singleton")
  matchCreatedAlarmOn Boolean  @default(true)
  mvpAlarmOn          Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

// D-DAY 미응답 투표 독촉 알림 스케줄(관리자가 알람 앱처럼 여러 개 등록).
// dayOffset은 경기일 기준 상대 일수(0 = 당일, -1 = D-1, -3 = D-3 ...).
model VoteReminderRule {
  id        String   @id @default(cuid())
  label     String?
  dayOffset Int
  hour      Int
  minute    Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 관리자 "확성기" 전체 공지 발송 이력.
model NoticeBroadcast {
  id             String   @id @default(cuid())
  message        String
  sentBy         String
  recipientCount Int
  createdAt      DateTime @default(now())

  sender User @relation(fields: [sentBy], references: [id])
}

// 카카오 메시지 발송 시도 로그(실제 발송 대행사 연동 전까지는 전부 STUBBED로
// 쌓인다) — lib/kakao.ts의 sendKakaoMessage() 참고.
model KakaoMessageLog {
  id         String             @id @default(cuid())
  type       KakaoMessageType
  userId     String?
  // matchDayId/ruleId는 FK가 아니라 단순 참조값 — 스케줄러가 "이 경기일에
  // 이미 MVP 알림을 보냈는지", "이 알람 규칙으로 이 경기일에 이미 독촉
  // 알림을 보냈는지"를 중복 발송 없이 판별하는 용도(원본 행이 나중에
  // 지워져도 발송 이력 자체는 남아야 하므로 관계로 걸지 않는다).
  matchDayId String?
  ruleId     String?
  message    String
  status     KakaoMessageStatus @default(STUBBED)
  createdAt  DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model MatchDay {
  id        String   @id @default(cuid())
  date      DateTime @unique
  time      String?
  location  String?
  createdBy String
  createdAt DateTime @default(now())

  creator      User                  @relation("CreatedMatchDays", fields: [createdBy], references: [id])
  participants MatchDayParticipant[]
  matches      Match[]
  photos       MatchDayPhoto[]
}

// 날짜당 현장 사진 여러 장(최대 10장, MatchDayPhoto.ts의 MAX_PHOTOS_PER_DAY 참고).
model MatchDayPhoto {
  id         String   @id @default(cuid())
  matchDayId String
  image      Bytes
  imageType  String
  uploadedBy String
  createdAt  DateTime @default(now())

  matchDay MatchDay @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploadedBy], references: [id])
}

model MatchDayParticipant {
  matchDayId String
  userId     String
  status     ParticipationStatus @default(PENDING)

  matchDay MatchDay @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([matchDayId, userId])
}

model EloRating {
  userId String
  type   MatchType
  rating Float     @default(1200)
  wins   Int       @default(0)
  losses Int       @default(0)
  draws  Int       @default(0)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, type])
}

// 복식의 경우 각 팀의 player1은 포핸드, player2는 백핸드 포지션을 의미한다.
// result/score는 admin이 점수를 입력해 경기를 완료 처리하기 전까지는 비어있다 (status=PENDING).
model Match {
  id             String       @id @default(cuid())
  matchDayId     String
  type           MatchType
  teamAPlayer1   String
  teamAPlayer2   String?
  teamBPlayer1   String
  teamBPlayer2   String?
  result         MatchResult?
  teamAScore     Int?
  teamBScore     Int?
  teamAEloChange Int?
  teamBEloChange Int?
  status         MatchStatus  @default(PENDING)
  submittedBy    String
  submittedAt    DateTime     @default(now())
  approvedBy     String?
  approvedAt     DateTime?
  approvalSeq    Int?         @unique

  matchDay   MatchDay     @relation(fields: [matchDayId], references: [id], onDelete: Cascade)
  submitter  User         @relation("SubmittedMatches", fields: [submittedBy], references: [id])
  eloHistory EloHistory[]
}

model EloHistory {
  id           String    @id @default(cuid())
  matchId      String
  userId       String
  type         MatchType
  ratingBefore Float
  ratingAfter  Float
  delta        Float
  createdAt    DateTime  @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
}
